# Copy to .env and adjust. `docker compose` reads this automatically.

# Image version. Pin a release for reproducible installs; `latest` tracks the
# newest stable release.
TAVREL_VERSION=0.1.0

# Host and container ports.
APP_PORT=5678
OTLP_HTTP_PORT=4318
OTLP_GRPC_PORT=4317

# Telemetry storage.
RETENTION_DAYS=30

# Ingest pipeline.
WORKER_COUNT=4
TASK_QUEUE_SIZE=256
OTLP_MAX_REQUEST_SIZE=8388608

# Protect the UI/API with a token. Empty disables authentication.
# 16-512 printable ASCII characters, no whitespace.
AUTH_TOKEN=

# Require X-API-Key / x-api-key on OTLP ingest. Empty disables ingest auth.
# 16-512 printable ASCII characters, no whitespace.
INGEST_TOKEN=
